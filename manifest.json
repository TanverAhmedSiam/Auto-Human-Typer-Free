{
  "manifest_version": 3,
  "name": "Human Auto Typer",
  "version": "1.0.0",
  "description": "Paste your text and have it typed into any page like a real person, with natural pauses and typos that get fixed.",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel", "debugger", "storage", "clipboardRead"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "action": {
    "default_title": "Human Auto Typer",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
